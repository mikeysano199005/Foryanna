# Base URL of this deployment, used for SEO metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://animora.example.com

# Optional: Supabase project credentials. When left unset, ANIMORA runs in
# local-only mode — the watchlist and watch history are stored in the
# browser's localStorage and authentication (login/register) is disabled
# with a graceful fallback message instead of crashing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
